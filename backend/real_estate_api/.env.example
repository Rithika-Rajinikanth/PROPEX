# =============================================================================
# PropX Dubai Backend Configuration
# =============================================================================

# PostgreSQL (PostGIS + pgvector + pgcrypto enabled)
DATABASE_URL=postgres://postgres:YourPassword%40123@localhost:5432/propx_exchange?sslmode=disable

# Server Bindings
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development

# Redis (Caching, Sessions & WebSocket channel relay)
REDIS_URL=redis://127.0.0.1:6379

# Kafka / Redpanda Event Broker
KAFKA_BROKERS=127.0.0.1:9092

# Microservices
ML_SERVICE_URL=http://localhost:8000

# Security & JWT
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRY_HOURS=24

# Logging
RUST_LOG=info,real_estate_api=debug,sqlx=warn
